# Give every physical ESP32 a unique name before flashing it.
DEVICE_NAME=octacore-1

# Preferred Wi-Fi credentials. Leave blank to use credentials already stored
# on the ESP32 or to configure Wi-Fi through the fallback captive portal.
WIFI_SSID=
WIFI_PASSWORD=

# Password for the fallback setup access point. Must be at least 8 characters.
SETUP_AP_PASSWORD=octacore-setup

WEBSOCKET_PORT=81
